  _dialogueId: KillSpidersQuestAlternativeStartDialogue
  _dialogueData:
  - lineId: 1
    dialogueLine: Are you rested? Ready to continue the battle?
    answerOption:
    - answerText: Yes. I will finish what I started.
      nextLineId: 2
      triggerComplete: 1
    - answerText: Need a little more time.
      nextLineId: 3
      triggerComplete: 0
    image: {fileID: 21300000, guid: 44036bdd3dc83864ca75d54ecd843074, type: 3}
  - lineId: 2
    dialogueLine: You are no longer just a traveler. You are the fire that can clear
      the thicket of darkness.
    answerOption:
    - answerText: Close
      nextLineId: 
      triggerComplete: 0
    image: {fileID: 21300000, guid: 44036bdd3dc83864ca75d54ecd843074, type: 3}
  - lineId: 3
    dialogueLine: Okay, but there's very little time left, so hurry up.
    answerOption:
    - answerText: Close
      nextLineId: 
      triggerComplete: 0
    image: {fileID: 21300000, guid: 44036bdd3dc83864ca75d54ecd843074, type: 3}
