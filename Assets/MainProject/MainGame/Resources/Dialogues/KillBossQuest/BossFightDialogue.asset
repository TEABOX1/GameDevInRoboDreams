MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12da250283eb4d21bd2b828afb3b8a8d, type: 3}
  m_Name: BossFightDialogue
  m_EditorClassIdentifier: 
  _dialogueId: BossFightDialogue
  _dialogueData:
  - lineId: 1
    dialogueLine: Oh, what a hero... He's chopping down my cronies like weeds. Do
      you think victory is near?
    answerOption:
    - answerText: Next
      nextLineId: 2
      triggerComplete: 0
    image: {fileID: 21300000, guid: c45efb10cb089bc42a3a5b6c70d79811, type: 3}
  - lineId: 2
    dialogueLine: If these creatures were your creations, then you are next.
    answerOption:
    - answerText: Next
      nextLineId: 3
      triggerComplete: 0
    image: {fileID: 21300000, guid: 3b263900f7c870a498421a2b6acdaf27, type: 3}
  - lineId: 3
    dialogueLine: "No. I am but a finger in the fist. The fist of my master. And
      he is\u2026 very unhappy that I am delaying in clearing this forest."
    answerOption:
    - answerText: Next
      nextLineId: 4
      triggerComplete: 0
    image: {fileID: 21300000, guid: c45efb10cb089bc42a3a5b6c70d79811, type: 3}
  - lineId: 4
    dialogueLine: Purification? You call this a filth that devours all living things?
    answerOption:
    - answerText: Next
      nextLineId: 5
      triggerComplete: 0
    image: {fileID: 21300000, guid: 3b263900f7c870a498421a2b6acdaf27, type: 3}
  - lineId: 5
    dialogueLine: Nature is too chaotic. We give it order. You are but a fragment
      of a broken sword, a memory of your former power. You will die here, on your
      knees, among the rotten roots of this forest.
    answerOption:
    - answerText: Next
      nextLineId: 6
      triggerComplete: 0
    image: {fileID: 21300000, guid: c45efb10cb089bc42a3a5b6c70d79811, type: 3}
  - lineId: 6
    dialogueLine: Nature is too chaotic. We give it order. You are but a fragment
      of a broken sword, a memory of your former power. You will die here, on your
      knees, among the rotten roots of this forest.
    answerOption:
    - answerText: Next
      nextLineId: 7
      triggerComplete: 0
    image: {fileID: 21300000, guid: 3b263900f7c870a498421a2b6acdaf27, type: 3}
  - lineId: 7
    dialogueLine: "Then die! By the fire of defilement, by the power of the lord,
      (mumbles something indistinct)\u2026 the spider will spill your blood!"
    answerOption:
    - answerText: Close
      nextLineId: 
      triggerComplete: 0
    image: {fileID: 21300000, guid: c45efb10cb089bc42a3a5b6c70d79811, type: 3}
  _alternativeDialogue: {fileID: 0}
